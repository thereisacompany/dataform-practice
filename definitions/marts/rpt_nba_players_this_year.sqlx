config {
  type: "table",
  name: "rpt_nba_players_this_year",
  schema: "dataform",
  tags: ["nba", "marts", "daily"],
  dependencies: ["fct_nba_players"]
}

SELECT
  player,
  age,
  birth_date,
  height_cm,
  weight_kg,
  season
FROM ${ref("fct_nba_players")}
WHERE season = EXTRACT(YEAR FROM CURRENT_DATE())
ORDER BY age DESC
