config {
  type: "incremental",
  name: "fct_billing_sample",
  schema: "dataform",
  uniqueKey: ["data_ym"],
  tags: ["billing", "marts", "ops"],
  bigquery: {
    partitionBy: "partition_date",
    updatePartitionFilter: `
      partition_date = DATE('${helpers.getPartitionFirstDay()}')
    `
  }
}

-- 平台味較重（pre_operations DELETE）。遷 dbt 時改 incremental_strategy
pre_operations {
  DELETE FROM ${self()}
  WHERE partition_date = DATE('${helpers.getPartitionFirstDay()}')
}

SELECT * FROM (
  SELECT
    '${helpers.getYearMonth()}' AS data_ym,
    999 AS billing,
    88 AS count,
    TIMESTAMP('${helpers.getTodayTimestamp()}') AS elt_time,
    DATE('${helpers.getPartitionFirstDay()}') AS partition_date
  FROM UNNEST([1])
)
${when(
  incremental(),
  `WHERE partition_date = DATE('${helpers.getPartitionFirstDay()}')`,
  ``
)}
