config {
  type: "incremental",
  schema: "dataform",
  name: "nba_players",
  uniqueKey: ["player", "season"]
}

SELECT
  player,
  DATE_DIFF(CURRENT_DATE(), birth_date, YEAR) AS age,
  birth_date,
  height_cm,
  weight_kg,
  EXTRACT(YEAR FROM CURRENT_DATE()) AS season
FROM ${ref("nba_players_base")}
